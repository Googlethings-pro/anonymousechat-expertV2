# =================================================================
# ANONYMOUS CHAT EXPERT VISUALCODEPO — Environment Variables
# =================================================================
# Salin file ini menjadi .env dan isi sesuai data kamu.
# JANGAN commit file .env ke Git!
# =================================================================

# ── 1. TELEGRAM BOT ───────────────────────────────────────────────
# Token dari @BotFather di Telegram
TELEGRAM_TOKEN=1234567890:AAH_contoh_token_kamu_disini

# Telegram ID angka milikmu (cek via @userinfobot)
OWNER_ID=123456789

# Username Telegram owner (tanpa @)
OWNER=username_kamu

# Username channel official bot (tanpa @)
CHANNEL=channel_bot_kamu

# Username bot (tanpa @)
BOT_USERNAME=nama_bot_kamu_bot

# ── 2. SUPABASE (DATABASE) ────────────────────────────────────────
# URL project Supabase (dari Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Service Role Key (bukan anon key!) — dari Settings → API
# Dibutuhkan agar bot bisa bypass Row Level Security (RLS)
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsI...


# ── 3. SERVER ─────────────────────────────────────────────────────
# Port HTTP server untuk webhook Midtrans
PORT=3000

# ── 4. REDIS (OPSIONAL — hanya untuk VPS/Production) ─────────────
# Jika tidak diset, bot otomatis pakai in-memory (cocok untuk Replit)
# Aktifkan ini hanya ketika deploy ke VPS dengan Redis terinstall
# Format: redis://localhost:6379 atau redis://:password@host:6379
REDIS_URL=redis://127.0.0.1:6379

# ── 5. NODE ENVIRONMENT ───────────────────────────────────────────
# 'development' untuk Replit, 'production' untuk VPS
NODE_ENV=production
